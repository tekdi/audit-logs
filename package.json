{
  "name": "@tekdi/audit-logger",
  "version": "2.0.0",
  "description": "Plug-and-play, env-driven audit/activity logging SDK for NestJS/Node.js services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./nestjs": {
      "import": "./dist/nestjs/index.js",
      "require": "./dist/nestjs/index.js",
      "types": "./dist/nestjs/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "sdk.env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --runInBand",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build",
    "start:consumer": "nest start --path apps/audit-api/tsconfig.json --watch --exec \"node apps/audit-api/dist/main.js\""
  },
  "dependencies": {
    "@nestjs/common": "^10.3.8",
    "@nestjs/core": "^10.3.8",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/config": "^3.2.2",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "kafkajs": "^2.2.4",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.spec.ts"
    ],
    "moduleNameMapper": {
      "^kafkajs$": "<rootDir>/src/__mocks__/kafkajs.ts"
    }
  },
  "keywords": [
    "audit",
    "logging",
    "kafka",
    "nestjs",
    "pii"
  ],
  "license": "MIT"
}
