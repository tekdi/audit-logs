# ─────────────────────────────────────────────────────────────────────────────
# Audit API .env.example  —  for apps/audit-api only
# This is the CENTRAL CONSUMER service that stores all audit events.
# Copy to apps/audit-api/.env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development          # development | staging | production
                              # production disables TypeORM auto-sync

# ─── Database ─────────────────────────────────────────────────────────────────
# ONLY the Audit API connects to PostgreSQL. Producer services never use these.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=audit_service_db      # Create this DB before starting: CREATE DATABASE audit_service_db;
DB_SSL=false                  # Set true to enforce TLS for DB connections

# ─── Kafka — Consumer ─────────────────────────────────────────────────────────
# Must match KAFKA_BROKERS and KAFKA_TOPIC in all producer services
AUDIT_ENABLED=true            # Set false to stop the Kafka consumer
AUDIT_SERVICE_NAME=audit-api-service
KAFKA_BROKERS=localhost:9092  # Same value as SDK KAFKA_BROKERS
KAFKA_TOPIC=audit.events      # Same value as SDK KAFKA_TOPIC
KAFKA_CLIENT_ID=audit-api-service
KAFKA_SSL_ENABLED=false

# ─── API Authentication ────────────────────────────────────────────────────────
# This key is validated by ApiKeyGuard on every incoming request.
# ALL producer services must set their AUDIT_API_KEY to this SAME value.
AUDIT_API_KEY=your-shared-secret-key

# ─── Partition Routing ────────────────────────────────────────────────────────
# Controls how logs are routed into service-specific PostgreSQL partitions.
# Add one entry per producer service.
AUDIT_PARTITIONING_ENABLED=true
AUDIT_AUTO_PARTITION_ENABLED=false
AUDIT_MATERIALIZE_ENABLED=false
AUDIT_DOMAIN_MAPPING_JSON='{
  "user-service":    {"table":"audit_logs_user_service"},
  "lms-service":     {"table":"audit_logs_lms_service"},
  "event-service":   {"table":"audit_logs_event_service"}
}'

# ─── Templates & Localization ─────────────────────────────────────────────────
AUDIT_DEFAULT_LANGUAGE=en
AUDIT_TEMPLATE_FALLBACK_LANGUAGE=en
