# ─────────────────────────────────────────────────────────────────────────────
# SDK .env.example  —  copy this into each PRODUCER microservice
# (user-service, lms-service, event-service, etc.)
# Rename to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Core (Required) ─────────────────────────────────────────────────────────
AUDIT_SERVICE_NAME=user-service        # REQUIRED — unique name per service
AUDIT_ENABLED=true                     # Set false to completely disable audit
AUDIT_MODE=kafka                       # kafka | api | hybrid
AUDIT_ENV=development                  # development | staging | production

# ─── Kafka — Producer ────────────────────────────────────────────────────────
# Required when AUDIT_MODE=kafka or AUDIT_MODE=hybrid
KAFKA_BROKERS=localhost:9092           # Comma-separated: broker1:9092,broker2:9092
KAFKA_TOPIC=audit.events               # Must match KAFKA_TOPIC in Audit API
KAFKA_CLIENT_ID=user-service           # Kafka client identifier for this service
KAFKA_SSL_ENABLED=false                # Set true for TLS-secured brokers
KAFKA_PRODUCER_TIMEOUT_MS=5000         # Broker ack timeout (ms)

# SASL Authentication (uncomment if your broker requires it)
# KAFKA_SASL_MECHANISM=scram-sha-256   # plain | scram-sha-256 | scram-sha-512
# KAFKA_SASL_USERNAME=your-username
# KAFKA_SASL_PASSWORD=your-password

# ─── Audit API — REST Fallback ────────────────────────────────────────────────
# Required when AUDIT_MODE=api or AUDIT_MODE=hybrid
AUDIT_API_BASE_URL=http://localhost:3001/api/v1   # URL of the running Audit API
AUDIT_API_KEY=your-shared-secret-key              # Must match Audit API AUDIT_API_KEY
AUDIT_API_ENABLED=true
AUDIT_API_TIMEOUT_MS=8000

# ─── Local Buffer — Safety Net ────────────────────────────────────────────────
# Events are buffered here when both Kafka and REST fail
AUDIT_LOCAL_STORAGE_ENABLED=true
AUDIT_LOCAL_STORAGE_TYPE=file          # memory | file
AUDIT_LOCAL_STORAGE_PATH=./.audit-buffer.json
AUDIT_LOCAL_STORAGE_MAX_SIZE=5000      # Max buffered events before oldest are dropped
AUDIT_SDK_RETRY_LIMIT=3               # Retries before buffering
AUDIT_SDK_RETRY_DELAY_MS=500          # Delay between retries (ms)

# ─── Event Filtering ──────────────────────────────────────────────────────────
AUDIT_CAPTURE_ALL=true
# AUDIT_INCLUDED_EVENTS_JSON='["user-service.COHORT.COHORT_CREATED"]'
AUDIT_EXCLUDED_EVENTS_JSON='["user-service.SYSTEM.HEALTH_CHECK"]'

# ─── PII Protection ───────────────────────────────────────────────────────────
AUDIT_PII_STRATEGY=mask                # mask | hash | encrypt | none
AUDIT_PII_FIELDS_JSON='["metadata.email","metadata.phone","metadata.nationalId"]'
AUDIT_PII_MASK_CONFIG_JSON='{"email":{"showFirst":2,"showDomain":true},"phone":{"showLast":3}}'
AUDIT_PII_HASH_ALGORITHM=sha256

# For encrypt strategy only — must be 32 bytes, base64-encoded:
# AUDIT_PII_ENCRYPT_KEY=your-32-byte-base64-encoded-key==
# AUDIT_PII_ENCRYPT_IV_LENGTH=16

# ─── Localization & Templates ─────────────────────────────────────────────────
AUDIT_DEFAULT_LANGUAGE=en
AUDIT_TEMPLATE_FALLBACK_LANGUAGE=en
# Maps event keys to named template keys stored in the Audit API DB:
AUDIT_TEMPLATE_MAPPING_JSON='{
  "user-service.USER.USER_CREATED":   {"templateKey":"USER_CREATED"},
  "user-service.USER.USER_UPDATED":   {"templateKey":"USER_PROFILE_UPDATED"},
  "user-service.COHORT.COHORT_CREATED": {"templateKey":"COHORT_CREATED"}
}'

# ─── Observability ────────────────────────────────────────────────────────────
AUDIT_SDK_LOG_LEVEL=info               # debug | info | warn | error | silent
AUDIT_SDK_LOG_FAILURES=true            # Log transport failures to console
AUDIT_METRICS_ENABLED=false
